APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# Chave LEGADA do agente. Instalação NOVA nasce com ela DESLIGADA: a chave
# 'Sistema' está publicada no repo, na documentação e no .ini distribuído — num
# portal novo ela deixaria qualquer um gravar na base fiscal do cliente.
#
# O caminho de uma instalação nova é o token por instalação: ao cadastrar o
# usuário no painel sai uma chave; cole o valor dela no Key= do .ini do cliente.
#
# Cliente ANTIGO não é afetado: ele tem .env próprio, com a chave ligada. Migre
# um a um (gere o token, troque o .ini) e só então ponha false no .env dele.
SYSTEM_ACCESS_KEY=
SYSTEM_LEGACY_KEY_ENABLED=false

# Log de PRODUÇÃO (ajustado 2026-07-15). NÃO volte para stack+debug:
#  - 'daily' rotaciona e mantém 14 dias (config/logging.php). O 'stack' cai no
#    'single' = UM arquivo só, que cresce para sempre e nunca é limpo.
#  - 'error' evita gravar dado fiscal (CNPJ, chave de acesso, termo de busca) em
#    texto plano caso algum Log::info/debug escape para produção — já aconteceu.
#    Não perdemos nada: o único Log:: do app é um Log::error, e as exceptions do
#    Laravel são reportadas em nível 'error'.
#  - Em DEV, se precisar depurar: LOG_LEVEL=debug no seu .env local (não aqui).
LOG_CHANNEL=daily
LOG_LEVEL=error
# Dias de log guardados. Acima disso o proprio Laravel apaga.
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true # produção HTTPS; em dev (http) use false ou remova

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── E-mail (SMTP) ───────────────────────────────────────────────────────────
# PREENCHA com os dados da caixa de e-mail DESTE cliente — os valores ficam
# vazios de propósito. Sem isso, "Esqueci minha senha" não funciona: o portal
# manda o e-mail na hora do clique (sem fila), então SMTP errado = nada chega.
#
# Onde achar: painel da hospedagem -> Contas de E-mail -> "Configurar cliente
# de e-mail". Use o servidor de SAÍDA (SMTP).
#
# Até 2026-07-30 estas linhas vinham com `MAIL_HOST=mailhog`, que é o container
# de DESENVOLVIMENTO daqui. Como o deploy.sh não toca em MAIL_*, todo portal
# novo subia apontando para um host que não existe no servidor.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls para a porta 587 | ssl para a 465
MAIL_ENCRYPTION=tls
# TEM de ser do domínio do cliente. Endereço de outro domínio é recusado ou cai
# em spam (SPF) — quem envia é o SMTP dele.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Portal do Contador"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PAGINATION_LIMIT=null # se null o valor default é 5
